page {
  background: #f5f7fa;
  color: #1f2a37;
  font-size: 28rpx;
  line-height: 1.5;
}

.container {
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.btn-primary {
  background: #1a4f7a;
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.btn-ghost {
  background: #eef3f8;
  color: #1a4f7a;
  border-radius: 12rpx;
}

.muted {
  color: #8a94a6;
  font-size: 24rpx;
}

.tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  background: #e8f1f8;
  color: #1a4f7a;
  margin-right: 12rpx;
}

.tag.inst {
  background: #eef8f0;
  color: #2f6b3a;
}

.empty {
  text-align: center;
  color: #8a94a6;
  padding: 80rpx 0;
}