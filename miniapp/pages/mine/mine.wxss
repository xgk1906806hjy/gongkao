.user {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}
.profile { display: flex; align-items: center; gap: 20rpx; flex: 1; }
.avatar-btn {
  padding: 0;
  margin: 0;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #eef3f8;
}
.avatar-btn::after { border: none; }
.avatar { width: 96rpx; height: 96rpx; }
.info { flex: 1; }
.nickname {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
}
.menu { font-size: 30rpx; }
.ai-entry { background: linear-gradient(135deg, #1a4f7a, #2f78b0); color: #fff; }
.ai-entry .muted { color: rgba(255, 255, 255, 0.8); }
