.tabs {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  color: #6b7280;
}
.tab.on {
  color: #1a4f7a;
  font-weight: 600;
  border-bottom: 4rpx solid #1a4f7a;
}
.search {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
  align-items: center;
}
.search input {
  flex: 1;
  background: #fff;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
}
.title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}
.meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}