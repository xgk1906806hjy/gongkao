.tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 12rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 12rpx;
  color: #5a6578;
}
.tab.on {
  background: #1a4f7a;
  color: #fff;
  font-weight: 600;
}
.status { margin: 0 8rpx 16rpx; }
.label, .h { font-weight: 700; font-size: 30rpx; margin-bottom: 16rpx; }
.p { margin-top: 12rpx; line-height: 1.7; }
.textarea {
  width: 100%;
  min-height: 280rpx;
  box-sizing: border-box;
  background: #f5f7fa;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 26rpx;
}
.textarea.short { min-height: 140rpx; margin-top: 16rpx; }
.link { color: #1a4f7a; margin-top: 16rpx; font-size: 26rpx; }
.form { margin-top: 8rpx; }
.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}
.val { color: #5a6578; }
.val-input { text-align: right; flex: 1; margin-left: 24rpx; color: #1f2a37; }
.submit { margin-top: 28rpx; }
.tip { margin-top: 12rpx; text-align: center; }
.notice {
  background: #fff7e6;
  color: #ad6800;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
  font-size: 24rpx;
}
.tags { margin-top: 12rpx; }
.li { padding: 8rpx 0; line-height: 1.6; }
.li.small { font-size: 24rpx; padding: 4rpx 0; }
.li.good::before { content: '✓ '; color: #2f8f4e; }
.li.warn::before { content: '! '; color: #d4380d; font-weight: 700; }
.dir { padding: 12rpx 0; border-bottom: 1rpx solid #f0f2f5; }
.dir:last-child { border-bottom: none; }
.dir-name { font-weight: 600; }
.rec { padding: 20rpx 0; border-bottom: 1rpx solid #f0f2f5; }
.card.rec { padding: 28rpx; border-bottom: none; }
.rec:last-child { border-bottom: none; }
.rec-head { display: flex; justify-content: space-between; gap: 16rpx; margin-bottom: 8rpx; }
.rec-title { font-weight: 600; flex: 1; line-height: 1.5; }
.score {
  min-width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 50%;
  background: #e8f1f8;
  color: #1a4f7a;
  font-weight: 700;
}
.countdown { font-size: 30rpx; }
.big { font-size: 64rpx; font-weight: 700; color: #1a4f7a; margin: 0 8rpx; }
.diag {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}
.diag-name { flex: 1; }
.level { margin-left: 16rpx; font-size: 22rpx; padding: 4rpx 12rpx; border-radius: 8rpx; background: #eef3f8; }
.lv-薄弱 { background: #fff1f0; color: #cf1322; }
.lv-一般 { background: #fff7e6; color: #ad6800; }
.lv-较好 { background: #f0f9f2; color: #2f8f4e; }
.block, .phase { padding: 14rpx 0; border-bottom: 1rpx solid #f0f2f5; }
.block:last-child, .phase:last-child { border-bottom: none; }
.block-head { display: flex; justify-content: space-between; }
.chat { padding-bottom: 140rpx; }
.msg { display: flex; flex-direction: column; margin-bottom: 20rpx; }
.msg.user { align-items: flex-end; }
.msg.ai { align-items: flex-start; }
.bubble {
  max-width: 82%;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  background: #fff;
}
.msg.user .bubble { background: #1a4f7a; color: #fff; }
.small { font-size: 22rpx; }
.ask-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.05);
}
.ask-input {
  flex: 1;
  background: #f5f7fa;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}
