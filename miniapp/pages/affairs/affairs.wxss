.search { display: flex; gap: 12rpx; margin-bottom: 20rpx; align-items: center; }
.search input { flex: 1; background: #fff; padding: 16rpx 20rpx; border-radius: 12rpx; }
.tags { white-space: nowrap; margin-bottom: 20rpx; }
.tag-item {
  display: inline-block;
  padding: 10rpx 20rpx;
  margin-right: 12rpx;
  background: #fff;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #6b7280;
}
.tag-item.on { background: #1a4f7a; color: #fff; }
.title { font-weight: 600; font-size: 30rpx; margin-bottom: 8rpx; }
.summary { margin-top: 12rpx; color: #4b5563; }