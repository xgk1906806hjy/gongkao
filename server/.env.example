APP_ENV=dev
HTTP_ADDR=:8080
# Postgres (production / docker): postgres://gongkao:gongkao@127.0.0.1:5432/gongkao?sslmode=disable
# Local smoke without Docker: sqlite:gongkao.db
DATABASE_URL=sqlite:gongkao.db
REDIS_URL=redis://127.0.0.1:6379/0
JWT_SECRET=gongkao-dev-secret-change-me
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=720h
WX_APPID=
WX_SECRET=
WX_MOCK=true
WX_SUBSCRIBE_TEMPLATE_TODO=
WX_SUBSCRIBE_TEMPLATE_AFFAIRS=
CRAWLER_ENABLED=true
# When true, seed demo rows only if no live crawl data exists.
CRAWLER_SEED_FALLBACK=true
# Optional extra affairs RSS (comma-separated). Built-in: 新华时政/法治、人民网时政。
CRAWLER_AFFAIRS_RSS_URL=
CRAWLER_AFFAIRS_RSS_URLS=
# Built-in announcement sources: 中国人事考试网(cpta)、中国政府网最新政策JSON(关键词过滤)、
# 湖北省人事考试网首页、湖南省2026年公务员考试列表、湖南省事业单位招聘列表。
# 非空时整表替换内置列表，格式 name|url，逗号分隔。
CRAWLER_ANNOUNCEMENT_LIST_URLS=
# 采集脚本把公告写入该表，API / Worker 启动时解析入库。路径相对 server 工作目录。
ANNOUNCEMENT_XLSX=data/announcements.xlsx
# P1: daily affairs subscribe push at 08:00 (requires template + user accept)
AFFAIRS_DAILY_PUSH_ENABLED=false
SESSION_KEY_AES_KEY=0123456789abcdef0123456789abcdef
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASS=admin123