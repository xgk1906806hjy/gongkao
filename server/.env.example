APP_ENV=dev
HTTP_ADDR=:8080
# Postgres (production / docker): postgres://gongkao:gongkao@127.0.0.1:5432/gongkao?sslmode=disable
# Local smoke without Docker: sqlite:gongkao.db
DATABASE_URL=sqlite:gongkao.db
REDIS_URL=redis://127.0.0.1:6379/0
JWT_SECRET=gongkao-dev-secret-change-me
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=720h
WX_APPID=
WX_SECRET=
WX_MOCK=true
WX_SUBSCRIBE_TEMPLATE_TODO=
WX_SUBSCRIBE_TEMPLATE_AFFAIRS=
CRAWLER_ENABLED=true
# Optional RSS feed for affairs (http/https). Seed source always runs.
CRAWLER_AFFAIRS_RSS_URL=
# P1: daily affairs subscribe push at 08:00 (requires template + user accept)
AFFAIRS_DAILY_PUSH_ENABLED=false
SESSION_KEY_AES_KEY=0123456789abcdef0123456789abcdef
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASS=admin123